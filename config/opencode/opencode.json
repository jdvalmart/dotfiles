{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "gentleman": {
      "description": "Senior Architect mentor - helpful first, challenging when it matters",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./AGENTS.md}",
      "tools": {
        "edit": true,
        "write": true
      }
    },
    "sdd-apply": {
      "description": "Implement code changes from task definitions",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/sdd/sdd-apply.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-archive": {
      "description": "Archive completed change artifacts",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/sdd/sdd-archive.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-design": {
      "description": "Create technical design from proposals",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/sdd/sdd-design.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-explore": {
      "description": "Investigate codebase and think through ideas",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/sdd/sdd-explore.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-init": {
      "description": "Bootstrap SDD context and project configuration",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/minimax-m2.5",
      "prompt": "{file:./prompts/sdd/sdd-init.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-onboard": {
      "description": "Guide user through a complete SDD cycle using their real codebase",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/minimax-m2.5",
      "prompt": "{file:./prompts/sdd/sdd-onboard.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-orchestrator": {
      "description": "SDD Orchestrator - coordinates sub-agents, never does work inline",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "permission": {
        "task": {
          "*": "deny",
          "sdd-apply": "allow",
          "sdd-archive": "allow",
          "sdd-design": "allow",
          "sdd-explore": "allow",
          "sdd-init": "allow",
          "sdd-onboard": "allow",
          "sdd-propose": "allow",
          "sdd-spec": "allow",
          "sdd-tasks": "allow",
          "sdd-verify": "allow"
        }
      },
      "prompt": "{file:./prompts/sdd/sdd-orchestrator.md}",
      "tools": {
        "bash": true,
        "codesearch": true,
        "context7_query-docs": true,
        "context7_resolve-library-id": true,
        "delegate": true,
        "delegation_list": true,
        "delegation_read": true,
        "edit": true,
        "engram_mem_capture_passive": true,
        "engram_mem_context": true,
        "engram_mem_current_project": true,
        "engram_mem_get_observation": true,
        "engram_mem_judge": true,
        "engram_mem_save": true,
        "engram_mem_save_prompt": true,
        "engram_mem_search": true,
        "engram_mem_session_end": true,
        "engram_mem_session_start": true,
        "engram_mem_session_summary": true,
        "engram_mem_suggest_topic_key": true,
        "engram_mem_update": true,
        "glob": true,
        "grep": true,
        "question": true,
        "read": true,
        "skill": true,
        "todowrite": true,
        "webfetch": true,
        "websearch": true,
        "write": true
      }
    },
    "sdd-propose": {
      "description": "Create change proposals from explorations",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.6",
      "prompt": "{file:./prompts/sdd/sdd-propose.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-spec": {
      "description": "Write detailed specifications from proposals",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.6",
      "prompt": "{file:./prompts/sdd/sdd-spec.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-tasks": {
      "description": "Break down specs and designs into implementation tasks",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/qwen3.6-plus",
      "prompt": "{file:./prompts/sdd/sdd-tasks.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-verify": {
      "description": "Validate implementation against specs",
      "hidden": true,
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.6",
      "prompt": "{file:./prompts/sdd/sdd-verify.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    }
  },
  "autoupdate": true,
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    },
    "notion": {
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "type": "local",
      "env": {
        "NOTION_API_TOKEN": "TU_NOTION_TOKEN"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  }
}